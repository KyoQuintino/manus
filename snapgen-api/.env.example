# Ambiente
SNAPGEN_ENVIRONMENT=development
SNAPGEN_VERSION=0.1.0
SNAPGEN_PUBLIC_BASE_URL=http://localhost:8000
SNAPGEN_STORAGE_DIR=./data/assets

# Defina para proteger as rotas /v1 com o cabeçalho X-API-Key
SNAPGEN_API_KEY=troque-esta-chave
SNAPGEN_WEBHOOK_SECRET=troque-este-segredo

# mock gera arquivos locais válidos para desenvolvimento.
# http usa o contrato documentado em README.md para um provedor real.
SNAPGEN_PROVIDER=mock
SNAPGEN_PROVIDER_BASE_URL=
SNAPGEN_PROVIDER_API_KEY=
SNAPGEN_PROVIDER_TIMEOUT=120
